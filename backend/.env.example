# Copy to .env and adjust. All values have safe dev defaults in config.py.

ENVIRONMENT=development

# Database (docker-compose provides this host as "db")
DATABASE_URL=postgresql+psycopg2://leads:leads@localhost:5432/leads
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis: broker for async email + store for rate limiting / idempotency
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
SEED_ATTORNEY_EMAIL=attorney@example.com
SEED_ATTORNEY_PASSWORD=changeme123
SEED_ATTORNEY_NAME=Alex Attorney

# File storage: local | s3
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# S3 / MinIO (only if STORAGE_BACKEND=s3)
# S3_BUCKET=resumes
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# Email delivery path: inline (BackgroundTask) | celery (worker pool)
EMAIL_DELIVERY=inline
# Email backend: console | smtp | sendgrid
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@leadmanager.example
ATTORNEY_NOTIFY_EMAIL=attorney@example.com

# SMTP (MailHog defaults)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false

# SendGrid (only if EMAIL_BACKEND=sendgrid)
# SENDGRID_API_KEY=

# Rate limiting on the public submit endpoint (Redis-backed)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PUBLIC=10/minute

# Idempotency for the public submit endpoint (Idempotency-Key header)
IDEMPOTENCY_ENABLED=false
IDEMPOTENCY_TTL_SECONDS=86400

# CORS
CORS_ORIGINS=http://localhost:3000
