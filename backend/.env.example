# Copy to .env and adjust. All values have safe dev defaults in config.py.

ENVIRONMENT=development

# Database (docker-compose provides this host as "db")
DATABASE_URL=postgresql+psycopg2://leads:leads@localhost:5432/leads

# Auth
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
SEED_ATTORNEY_EMAIL=attorney@example.com
SEED_ATTORNEY_PASSWORD=changeme123
SEED_ATTORNEY_NAME=Alex Attorney

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Email: console | smtp | sendgrid
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@leadmanager.example
ATTORNEY_NOTIFY_EMAIL=attorney@example.com

# SMTP (MailHog defaults)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false

# SendGrid (only if EMAIL_BACKEND=sendgrid)
# SENDGRID_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000
